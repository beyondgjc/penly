<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 泄露哨兵（密码体检）首个联网功能：仅向 api.pwnedpasswords.com 发送密码哈希前 5 位 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PenlyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Penly"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Penly">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 覆盖 zxing 库的 CaptureActivity 横屏声明（sensorLandscape）：扫码统一竖屏 -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="android:screenOrientation" />

        <!-- 系统自动填充服务（v3.0 项目⑤）：登录页填充/保存密码；exported=true 供系统绑定，BIND_AUTOFILL_SERVICE 权限保护 -->
        <service
            android:name=".autofill.PenlyAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

        <!-- 自动填充解锁浮层（v3.0 项目⑤）：仅由本应用 PendingIntent 拉起，exported=false。
             透明主题（N9）：点认证卡片后指纹框直接悬浮在客户端上，无跳转感 -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="印迹 · 自动填充验证"
            android:theme="@style/Theme.Penly.Translucent" />

        <!-- Passkey 凭据提供器（v5.0-②，Android 14+）：双阶段协议第一阶段，begin 零数据
             访问（锁定态不扫库），只回泛化条目 + 指向 PasskeyActivity 的 PendingIntent。
             低版本系统不识别该 action，无需版本门控。 -->
        <service
            android:name=".passkey.PasskeyProviderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider_config" />
        </service>

        <!-- Passkey 解锁浮层：与 AutofillAuthActivity 同范式（透明主题、双阶段、用后即弃） -->
        <activity
            android:name=".passkey.PasskeyActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="印迹 · Passkey 验证"
            android:theme="@style/Theme.Penly.Translucent" />
    </application>

</manifest>