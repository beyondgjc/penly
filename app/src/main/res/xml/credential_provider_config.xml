<?xml version="1.0" encoding="utf-8"?>
<!-- v5.0-②：第一期 passkey-only（2026-09-19 拍板），只声明公钥凭据能力。
     注意：根 tag 是 credential-provider（framework CredentialProviderInfo 实际解析的
     常量，2026-09-19 从 framework.jar 字符串实锤）；androidx 集成文档示例写的
     credentials-provider（复数）与系统实现不符，会静默解析失败 → capabilities 为空 →
     系统「Service does not have the required capabilities」永不调用 begin 回调。 -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
